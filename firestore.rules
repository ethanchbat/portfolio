rules_version = '2';

// Single-admin pattern: anyone can read site content (there's nothing
// sensitive in it), but only your account can write. Replace the UID below
// with yours (Firebase Console > Authentication > Users > copy the "User UID"
// column for the account you created) before publishing these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "HxMnlGI5atU2oxyKWje6orHTHAu2";
    }

    match /content/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /works/{workId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
